{
  "screenTags": ["旁白", "画面", "字幕"],
  "omitTags": ["内心", "心声", "删除", "备注", "演出"],
  "innerWords": ["内心", "心声", "心理活动", "内心独白"],
  "narrators": ["旁白", "时间与地点", "第一章", "第二章", "第三章", "最终章"],
  "tagPattern": "^〔([^〕]+)〕(.*)$",
  "asciiTagPattern": "^\\[([^\\[\\]]+)\\](.*)$",
  "screenPattern": "^［\\s*(.*?)\\s*］$",
  "innerPattern": "^（([^）]+)）\\s*「(.*)」$",
  "spokenPattern": "^([^「]{1,40}?)\\s*「(.*)」$",
  "colonPattern": "^([^：:\\d「」。！，、｜]{1,40})[：:](.*)$",
  "cuePattern": "^(?:[^\\s“”「」…？！。！，、｜（）():：]{1,20}[（(].*[）)]|（.*）|\\(.*\\))$",
  "asidePattern": "（[^（）]*）|\\([^()]*\\)"
}
