{
  "chapter": "final",
  "voiceRole": "成田基生",
  "status": "draft",
  "lines": [
    { "line_id": "fin_026", "speech_text": "……！" },
    { "line_id": "fin_037", "speech_text": "ILY……" },
    { "line_id": "fin_038", "speech_text": "僕は……" },
    { "line_id": "fin_039", "speech_text": "確かに僕は、ずっと、ずっと愛理のことを思っていた。" },
    { "line_id": "fin_040", "speech_text": "この十年間、いつだって愛理のことだけを思い続けていた……自分では、そう思っていた。" },
    { "line_id": "fin_041", "speech_text": "でも僕が思っていたのは、携帯の中にいて、僕の記憶の中にいて、何もかも僕の望みどおりにしてくれる愛理だけだった。" },
    { "line_id": "fin_042", "speech_text": "あの頃の愛理が感じていた悲しみも、寂しさも、僕は何一つ知らなかった。" },
    { "line_id": "fin_043", "speech_text": "もし僕が本当に愛理のことを思えていたなら、愛理は僕の前から消えたりしなかった……" },
    { "line_id": "fin_044", "speech_text": "そうだ。だから……" },
    { "line_id": "fin_045", "speech_text": "ILY……" },
    { "line_id": "fin_046", "speech_text": "もしILYが、僕の過ごしてきた時間の中に、愛理へ注いだ感情の中に、温もりを感じてくれたのなら……" },
    { "line_id": "fin_047", "speech_text": "僕のその気持ちはきっと、僕を見つけて、そばにいてくれた『ILY』に注がれていたんだ。" },
    { "line_id": "fin_051", "speech_text": "うん……そうだよ。" },
    { "line_id": "fin_062", "speech_text": "ILY！？" },
    { "line_id": "fin_086", "speech_text": "ILY……君の身体が……！！" },
    { "line_id": "fin_098", "speech_text": "消えるって……そんな……！" },
    { "line_id": "fin_103", "speech_text": "そ……そんなの……！" },
    { "line_id": "fin_104", "speech_text": "ILY、こんなに苦しそうで……しかも、こんな姿になって……！" },
    { "line_id": "fin_105", "speech_text": "もしILYが僕を食べれば……それで、この苦しみから解放されるのか！？" },
    { "line_id": "fin_106", "speech_text": "ILYのためなら、僕はどうなってもいい……！ でも、ILYがこの世界から消えるなんて、耐えられない……" },
    { "line_id": "fin_120", "speech_text": "ILY……" },
    { "line_id": "fin_125", "speech_text": "うっ、ううっ……" },
    { "line_id": "fin_127", "speech_text": "言って、ILY。" },
    { "line_id": "fin_135", "speech_text": "ILY……ILY……！" },
    { "line_id": "fin_136", "speech_text": "『うっ……うう……』" },
    { "line_id": "fin_137", "speech_text": "僕も……僕も、ずっと……！" },
    { "line_id": "fin_139", "speech_text": "ずっと……君のことが好きだ。" },
    { "line_id": "fin_140", "speech_text": "ILY……" }
  ]
}
