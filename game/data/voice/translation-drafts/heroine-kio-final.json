{
  "chapter": "heroine",
  "voiceRole": "成田基生",
  "status": "draft",
  "lines": [
    { "line_id": "her_0032", "speech_text": "愛理、どれが食べたい？" },
    { "line_id": "her_0034", "speech_text": "相変わらず優柔不断だな。" },
    { "line_id": "her_0035", "speech_text": "これはどう？ 愛理が好きそうだ。" },
    { "line_id": "her_0037", "speech_text": "愛理、どれが食べたい？" },
    { "line_id": "her_0039", "speech_text": "相変わらず優柔不断だな。" },
    { "line_id": "her_0040", "speech_text": "これはどう？ 愛理が好きそうだ。" },
    { "line_id": "her_0047", "speech_text": "でも、愛理は出かけるのが好きだっただろ……？" },
    { "line_id": "her_0051", "speech_text": "服……服を買いに行こう！！" },
    { "line_id": "her_0053", "speech_text": "一人で行って、本当に大丈夫か？" },
    { "line_id": "her_0055", "speech_text": "分かった……じゃあ何かあったら、すぐ電話して。" },
    { "line_id": "her_0115", "speech_text": "愛理、おかえり。" },
    { "line_id": "her_0118", "speech_text": "僕も、愛理のことが、だ、大好……" },
    { "line_id": "her_0122", "speech_text": "……ごめん、失礼する！" },
    { "line_id": "her_0125", "speech_text": "送るわけないだろ……" },
    { "line_id": "her_0152", "speech_text": "何だよ……それ……" },
    { "line_id": "her_0153", "speech_text": "言葉にして、言葉にしてって……全部言わなきゃいけないのか？ 何も言わなかったら、愛理には本当に何も分からないのか！？" },
    { "line_id": "her_0154", "speech_text": "どうして愛理は、そんなに言葉にすることにこだわるんだ！？ 僕の気持ちが、君を置いて一人にすることだって……何だよ、それ。" },
    { "line_id": "her_0155", "speech_text": "ずっと、ずっと……ずっと一人だったのは、僕のほうじゃないか……？" },
    { "line_id": "her_0156", "speech_text": "突然僕の前から消えて、また突然現れて、『大好き』『大好き』って……僕には、愛理の言う『大好き』が何なのか分からないんだ……" },
    { "line_id": "her_0157", "speech_text": "愛理の『大好き』って、何なんだよ！？" },
    { "line_id": "her_0162", "speech_text": "……愛理？" },
    { "line_id": "her_0164", "speech_text": "愛理？" },
    { "line_id": "her_0165", "speech_text": "大丈夫か……？" },
    { "line_id": "her_0172", "speech_text": "だい……" },
    { "line_id": "her_0178", "speech_text": "あ、愛理。" },
    { "line_id": "her_0213", "speech_text": "誓うよ。僕にとって、愛理は本当に大切だから。" },
    { "line_id": "her_0220", "speech_text": "大好……" },
    { "line_id": "her_0249", "speech_text": "前に来たのは高校生の時……六月だったよな。" },
    { "line_id": "her_0250", "speech_text": "紫陽花が一面に咲いてた。" },
    { "line_id": "her_0258", "speech_text": "来年の六月に。" },
    { "line_id": "her_0291", "speech_text": "じゃあ、僕は——" },
    { "line_id": "her_0327", "speech_text": "愛理……？" },
    { "line_id": "her_0361", "speech_text": "僕……と……？" },
    { "line_id": "her_0386", "speech_text": "いえ……大丈夫です。" },
    { "line_id": "her_0400", "speech_text": "……だから……あれはただの幻だったんだ……" }
  ]
}
