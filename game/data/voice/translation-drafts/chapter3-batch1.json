{
  "chapter": "chapter3",
  "status": "draft",
  "lines": [
    { "line_id": "ch3_025", "speech_text": "僕……と……？" },
    { "line_id": "ch3_040", "speech_text": "あ……" },
    { "line_id": "ch3_041", "speech_text": "あ、ああ。" },
    { "line_id": "ch3_042", "speech_text": "大丈夫……はは……" },
    { "line_id": "ch3_057", "speech_text": "あ。" },
    { "line_id": "ch3_058", "speech_text": "うん。" },
    { "line_id": "ch3_059", "speech_text": "あ……うん。" },
    { "line_id": "ch3_079", "speech_text": "架空の……愛理……って、どういう意味だ……" },
    { "line_id": "ch3_082", "speech_text": "……え？" },
    { "line_id": "ch3_089", "speech_text": "浮かない顔って……どういうことだ？" },
    { "line_id": "ch3_129", "speech_text": "愛理……" },
    { "line_id": "ch3_130", "speech_text": "僕は……" },
    { "line_id": "ch3_135", "speech_text": "！" },
    { "line_id": "ch3_148", "speech_text": "あ……" },
    { "line_id": "ch3_159", "speech_text": "もしもし、成田です。" },
    { "line_id": "ch3_161", "speech_text": "いえ……大丈夫です。" },
    { "line_id": "ch3_164", "speech_text": "あ……いいですよ。行きます。" },
    { "line_id": "ch3_166", "speech_text": "何でもないです……" },
    { "line_id": "ch3_167", "speech_text": "あの……いつ伺えばいいですか？" },
    { "line_id": "ch3_174", "speech_text": "……もういい、充電しなくて……そろそろ捨てないとな……" },
    { "line_id": "ch3_177", "speech_text": "！！" },
    { "line_id": "ch3_178", "speech_text": "……だから……あれはただの幻だったんだ……" },
    { "line_id": "ch3_180", "speech_text": "そんなこと、早く忘れたほうがいい……" },
    { "line_id": "ch3_185", "speech_text": "あ……僕は……やめておきます……" },
    { "line_id": "ch3_187", "speech_text": "……本当にすみません……僕、お酒は飲めなくて……" },
    { "line_id": "ch3_190", "speech_text": "あ……あの、僕の携帯が……" },
    { "line_id": "ch3_192", "speech_text": "ないわけじゃないですけど……" },
    { "line_id": "ch3_198", "speech_text": "違いますよ。どうしてそう思うんですか……？" },
    { "line_id": "ch3_200", "speech_text": "まだ、決めてません……というか、携帯のことは全然分からなくて……どんな機種があるのかも知らないんです……" },
    { "line_id": "ch3_204", "speech_text": "あ……それは、ありがとうございます。" },
    { "line_id": "ch3_208", "speech_text": "すみません、僕、さっき何か変なことを言いましたか……" },
    { "line_id": "ch3_218", "speech_text": "うわっ！" },
    { "line_id": "ch3_220", "speech_text": "虫か……！？" },
    { "line_id": "ch3_221", "speech_text": "今のは何だったんだ……！" },
    { "line_id": "ch3_223", "speech_text": "はあ……" },
    { "line_id": "ch3_224", "speech_text": "何なんだよ……" },
    { "line_id": "ch3_225", "speech_text": "気持ち悪い……" },
    { "line_id": "ch3_231", "speech_text": "あ……家にいても暇で、何もすることがなかったので……" },
    { "line_id": "ch3_model_after", "speech_text": "この一台……これから、よろしく。" },
    { "line_id": "ch3_240", "speech_text": "大きい……慣れないな……" },
    { "line_id": "ch3_242", "speech_text": "日日谷さん、いろいろとありがとうございます。本当に助かりました。" },
    { "line_id": "ch3_245", "speech_text": "ん？" },
    { "line_id": "ch3_250", "speech_text": "そうなんですか？" },
    { "line_id": "ch3_252", "speech_text": "おお……すごい……" },
    { "line_id": "ch3_253", "speech_text": "これで追加できたんですか？" },
    { "line_id": "ch3_269", "speech_text": "あ、すみません……何でもないです……" },
    { "line_id": "ch3_271", "speech_text": "そうだ……本当に番号を残さなくていいんですか？" },
    { "line_id": "ch3_276", "speech_text": "……いいんです。もう十年以上使いましたし……もともと捨てるつもりでした。" },
    { "line_id": "ch3_277", "speech_text": "それに、引き継ぎたいものも……残しておきたいものも、何もありません。" },
    { "line_id": "ch3_279", "speech_text": "はい……でも、もうどうでもいいんです。消えてしまえばいい。全部、消えてしまえば。" }
  ]
}
