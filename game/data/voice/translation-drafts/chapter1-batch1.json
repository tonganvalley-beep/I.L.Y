{
  "chapter": "chapter1",
  "status": "draft",
  "lines": [
    {
      "line_id": "ch1_005",
      "speech_text": "あ……あい……"
    },
    {
      "line_id": "ch1_010",
      "speech_text": "忘れるわけない……僕は一度だって、愛理のことを忘れたことなんてない……一度も……"
    },
    {
      "line_id": "ch1_011",
      "speech_text": "なあ、愛理は今まで、いったい何をしてたんだ？ どこにいたんだ？ どうしてまだ制服を着てるんだ……僕はずっと、愛理と連絡を取りたかった。この十年間……ずっと……"
    },
    {
      "line_id": "ch1_012",
      "speech_text": "愛理、どうして……どうして今になって……"
    },
    {
      "line_id": "ch1_015",
      "speech_text": "うん……うん、僕も……でも……愛理、どうしたんだ？"
    },
    {
      "line_id": "ch1_019",
      "speech_text": "うわあああああっ！！！"
    },
    {
      "line_id": "ch1_032",
      "speech_text": "い、生きてる！ 死んでない！ 僕は大丈夫だ！！"
    },
    {
      "line_id": "ch1_039",
      "speech_text": "あ、愛理……昨日……僕たち、海にいたんだよな？"
    },
    {
      "line_id": "ch1_041",
      "speech_text": "……海で再会して、それから、どうなったんだ？ 僕たちはどうやって……家に帰ってきたんだ。"
    },
    {
      "line_id": "ch1_042",
      "speech_text": "どうして昨夜『家に帰った』記憶がないんだ？ 海辺からこのアパートまでの間だけ、どうしても思い出せない空白がある。"
    },
    {
      "line_id": "ch1_049",
      "speech_text": "……いや、こういう時は普通……救急車を呼ぶんじゃないか？ 助けてくれたのはありがたいけど……僕、ずっと意識がなかったんだろ？"
    },
    {
      "line_id": "ch1_053",
      "speech_text": "ん？ ああ、少し。"
    },
    {
      "line_id": "ch1_057",
      "speech_text": "確かに高校の頃は、馬鹿みたいに毎日食べてたな……青春だなあ。あ、でも今はチョココロネじゃなくていいよ……"
    },
    {
      "line_id": "ch1_065",
      "speech_text": "いや……何でもない。"
    },
    {
      "line_id": "ch1_082",
      "speech_text": "ん？"
    },
    {
      "line_id": "ch1_084",
      "speech_text": "え？"
    },
    {
      "line_id": "ch1_086",
      "speech_text": "いや、違う！ 嫌ってわけじゃないんだ……"
    },
    {
      "line_id": "ch1_088",
      "speech_text": "で、でも……"
    },
    {
      "line_id": "ch1_090",
      "speech_text": "ぼ、僕もそう思ってる！ でも、うちは狭いし、面白いものも何もないし……古いゲームなら少しあるけど……"
    },
    {
      "line_id": "ch1_092",
      "speech_text": "！"
    },
    {
      "line_id": "ch1_094",
      "speech_text": "あ……うん、分かった。愛理が気にしないなら……"
    },
    {
      "line_id": "ch1_098",
      "speech_text": "夏休み……"
    },
    {
      "line_id": "ch1_100",
      "speech_text": "『うん……』"
    },
    {
      "line_id": "ch1_102",
      "speech_text": "『うん……』"
    },
    {
      "line_id": "ch1_104",
      "speech_text": "『うん……』"
    },
    {
      "line_id": "ch1_106",
      "speech_text": "……待て、どうして急に承諾したんだ……うちの……風呂場……最後に掃除したの、いつだったっけ？"
    },
    {
      "line_id": "ch1_107",
      "speech_text": "愛理！！ ごめん！！ うちの風呂場、すごく汚いんだ。ちょっと待ってくれ——"
    },
    {
      "line_id": "ch1_110",
      "speech_text": "あ……"
    },
    {
      "line_id": "ch1_112",
      "speech_text": "あ……愛理……ごめ……"
    },
    {
      "line_id": "ch1_115",
      "speech_text": "本当にごめん……わざと覗こうとしたんじゃないんだ……"
    },
    {
      "line_id": "ch1_117",
      "speech_text": "愛理をあんな汚い風呂場に入れちゃいけないと思っただけなんだ……ここを掃除するから、少し待っててくれ……"
    },
    {
      "line_id": "ch1_123",
      "speech_text": "僕もシャワーを浴びてくる……ここで漫画でも読んで待ってて。"
    },
    {
      "line_id": "ch1_125",
      "speech_text": "ん？ そうだな……"
    },
    {
      "line_id": "ch1_138",
      "speech_text": "あ、もうこんな時間か……"
    },
    {
      "line_id": "ch1_140",
      "speech_text": "そうだ。何か食べるものを買いに行こう——"
    },
    {
      "line_id": "ch1_142",
      "speech_text": "……『愛理』？"
    },
    {
      "line_id": "ch1_148",
      "speech_text": "あ……アイスはあとで取ろう……溶けちゃうから……"
    },
    {
      "line_id": "ch1_151",
      "speech_text": "愛理、どれが食べたい？"
    },
    {
      "line_id": "ch1_153",
      "speech_text": "相変わらず優柔不断だな。これはどう？ 愛理が好きそうだ。"
    },
    {
      "line_id": "ch1_162",
      "speech_text": "あ、いや、なんというか……ちょっと、何て言えばいいのか……"
    },
    {
      "line_id": "ch1_164",
      "speech_text": "早く帰ろう、妹よ。"
    },
    {
      "line_id": "ch1_167",
      "speech_text": "気にするな！"
    },
    {
      "line_id": "ch1_172",
      "speech_text": "いや、僕は大丈夫……カップ麺でいいのか？"
    },
    {
      "line_id": "ch1_174",
      "speech_text": "はいはい……"
    },
    {
      "line_id": "ch1_176",
      "speech_text": "うんうん、いいよ。"
    },
    {
      "line_id": "ch1_178",
      "speech_text": "野乃？ ああ、愛理の従妹か……"
    }
  ]
}
