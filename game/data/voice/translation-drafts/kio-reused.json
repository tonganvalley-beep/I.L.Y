{
  "voiceRole": "成田基生",
  "status": "draft",
  "lines": [
    {
      "line_id": "her_0057",
      "speech_text": "うん、行ってらっしゃい。"
    },
    {
      "line_id": "her_0179",
      "speech_text": "よかった……目が覚めたんだな……"
    },
    {
      "line_id": "her_0180",
      "speech_text": "大丈夫か？ もう身体は平気なのか？"
    },
    {
      "line_id": "her_0182",
      "speech_text": "貧血か……"
    },
    {
      "line_id": "her_0183",
      "speech_text": "無理しないで、まだ横になってたほうがいいんじゃないか……"
    },
    {
      "line_id": "her_0191",
      "speech_text": "愛理、"
    },
    {
      "line_id": "her_0193",
      "speech_text": "ごめん……"
    },
    {
      "line_id": "her_0194",
      "speech_text": "あの時、愛理を一人にするべきじゃなかった……"
    },
    {
      "line_id": "her_0195",
      "speech_text": "君がすごく不安だったって分かってたのに、僕は……"
    },
    {
      "line_id": "her_0196",
      "speech_text": "自分のことばかり、一方的に話してた。"
    },
    {
      "line_id": "her_0197",
      "speech_text": "本当にごめん……"
    },
    {
      "line_id": "her_0200",
      "speech_text": "え、あの……ごめん！ 僕……！"
    },
    {
      "line_id": "her_0201",
      "speech_text": "まさか、あの時どこか怪我したのか……！？"
    },
    {
      "line_id": "her_0204",
      "speech_text": "ね、熱があるのか……！？"
    },
    {
      "line_id": "her_0211",
      "speech_text": "愛理、僕は……"
    },
    {
      "line_id": "her_0212",
      "speech_text": "もう二度と、君を一人にしない。"
    },
    {
      "line_id": "her_0215",
      "speech_text": "だから……僕が言葉にしないことで愛理が不安になるなら、今、ちゃんと伝えるよ。"
    },
    {
      "line_id": "her_0218",
      "speech_text": "僕も……愛理のことが……"
    },
    {
      "line_id": "her_0225",
      "speech_text": "え？ あ……愛理？"
    },
    {
      "line_id": "her_0241",
      "speech_text": "江ノ島……久しぶりだな。"
    },
    {
      "line_id": "her_0242",
      "speech_text": "今日は晴れてよかったな。"
    },
    {
      "line_id": "her_0244",
      "speech_text": "行こう、愛理。"
    },
    {
      "line_id": "her_0248",
      "speech_text": "ああ……懐かしいな。"
    },
    {
      "line_id": "her_0252",
      "speech_text": "今はもう八月だからな——"
    },
    {
      "line_id": "her_0253",
      "speech_text": "あ、まだ少し咲いてる。"
    },
    {
      "line_id": "her_0257",
      "speech_text": "……来年、また一緒に来よう。"
    },
    {
      "line_id": "her_0274",
      "speech_text": "どうしたんだ、急にそんなこと言って……"
    },
    {
      "line_id": "her_0275",
      "speech_text": "うん、"
    },
    {
      "line_id": "her_0276",
      "speech_text": "僕も、ずっと愛理と一緒にいたい。"
    },
    {
      "line_id": "her_0279",
      "speech_text": "ここで最後だ……そろそろ帰ろうか？"
    },
    {
      "line_id": "her_0282",
      "speech_text": "……そうだ！"
    },
    {
      "line_id": "her_0283",
      "speech_text": "……ここ、すごくきれいな夕日が見えるんだ。"
    },
    {
      "line_id": "her_0284",
      "speech_text": "昨日、調べたんだ。いちおう、デートだから……"
    },
    {
      "line_id": "her_0285",
      "speech_text": "だから……"
    },
    {
      "line_id": "her_0286",
      "speech_text": "まだ少し時間があるし……一緒に夕日を見ないか？"
    },
    {
      "line_id": "her_0289",
      "speech_text": "……うん、じゃあここで少し待とう。"
    },
    {
      "line_id": "her_0292",
      "speech_text": "飲み物を買ってくるよ。愛理は何が飲みたい？"
    },
    {
      "line_id": "her_0294",
      "speech_text": "分かった。じゃあ少し待ってて。"
    },
    {
      "line_id": "her_0296",
      "speech_text": "いいよ、いいよ。このあと階段も上るし、疲れるだろ。"
    },
    {
      "line_id": "her_0298",
      "speech_text": "うん。"
    },
    {
      "line_id": "her_0299",
      "speech_text": "……海に落ちたりしないよな？"
    },
    {
      "line_id": "her_0384",
      "speech_text": "もしもし、成田です。"
    },
    {
      "line_id": "her_0389",
      "speech_text": "あ……いいですよ。行きます。"
    },
    {
      "line_id": "her_0391",
      "speech_text": "何でもないです……"
    },
    {
      "line_id": "her_0392",
      "speech_text": "あの……いつ伺えばいいですか？"
    },
    {
      "line_id": "her_0396",
      "speech_text": "……もういい、充電しなくて……そろそろ捨てないとな……"
    },
    {
      "line_id": "her_0399",
      "speech_text": "！！"
    },
    {
      "line_id": "her_0401",
      "speech_text": "そんなこと、早く忘れたほうがいい……"
    },
    {
      "line_id": "her_0424",
      "speech_text": "うわっ！"
    },
    {
      "line_id": "her_0427",
      "speech_text": "今のは何だったんだ……！"
    },
    {
      "line_id": "her_0428",
      "speech_text": "虫か……！？"
    },
    {
      "line_id": "her_0430",
      "speech_text": "はあ……"
    },
    {
      "line_id": "her_0431",
      "speech_text": "何なんだよ……"
    },
    {
      "line_id": "her_0432",
      "speech_text": "気持ち悪い……"
    },
    {
      "line_id": "fin_126",
      "speech_text": "うん、"
    },
    {
      "line_id": "fin_158",
      "speech_text": "んー？ んー。"
    }
  ]
}
