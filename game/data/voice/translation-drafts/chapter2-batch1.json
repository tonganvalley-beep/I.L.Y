{
  "chapter": "chapter2",
  "status": "draft",
  "lines": [
    {
      "line_id": "ch2_005",
      "speech_text": "愛理——！？"
    },
    {
      "line_id": "ch2_007",
      "speech_text": "よかった……目が覚めたんだな……"
    },
    {
      "line_id": "ch2_008",
      "speech_text": "大丈夫か？ もう身体は平気なのか？"
    },
    {
      "line_id": "ch2_012",
      "speech_text": "貧血か……"
    },
    {
      "line_id": "ch2_013",
      "speech_text": "無理しないで、まだ横になってたほうがいいんじゃないか……"
    },
    {
      "line_id": "ch2_021",
      "speech_text": "愛理、"
    },
    {
      "line_id": "ch2_024",
      "speech_text": "ごめん……"
    },
    {
      "line_id": "ch2_026",
      "speech_text": "あの時、愛理を一人にするべきじゃなかった……"
    },
    {
      "line_id": "ch2_027",
      "speech_text": "君がすごく不安だったって分かってたのに、僕は……"
    },
    {
      "line_id": "ch2_028",
      "speech_text": "自分のことばかり、一方的に話してた。"
    },
    {
      "line_id": "ch2_029",
      "speech_text": "本当にごめん……"
    },
    {
      "line_id": "ch2_035",
      "speech_text": "え、あの……ごめん！ 僕……！"
    },
    {
      "line_id": "ch2_036",
      "speech_text": "まさか、あの時どこか怪我したのか……！？"
    },
    {
      "line_id": "ch2_040",
      "speech_text": "ね、熱があるのか……！？"
    },
    {
      "line_id": "ch2_045",
      "speech_text": "愛理、僕は……"
    },
    {
      "line_id": "ch2_046",
      "speech_text": "もう二度と、君を一人にしない。"
    },
    {
      "line_id": "ch2_048",
      "speech_text": "僕にとって、愛理は本当に大切だから。"
    },
    {
      "line_id": "ch2_051",
      "speech_text": "だから……僕が言葉にしないことで愛理が不安になるなら、今、ちゃんと伝えるよ。"
    },
    {
      "line_id": "ch2_053",
      "speech_text": "僕も……愛理のことが……"
    },
    {
      "line_id": "ch2_054",
      "speech_text": "大好——"
    },
    {
      "line_id": "ch2_061",
      "speech_text": "……分かった。もう言わない。"
    },
    {
      "line_id": "ch2_066",
      "speech_text": "どうして言っちゃいけないんだ？ 愛理。"
    },
    {
      "line_id": "ch2_076",
      "speech_text": "え？ あ……愛理？"
    },
    {
      "line_id": "ch2_081",
      "speech_text": "早いな……"
    },
    {
      "line_id": "ch2_085",
      "speech_text": "……百合沢……"
    },
    {
      "line_id": "ch2_090",
      "speech_text": "江ノ島……久しぶりだな。"
    },
    {
      "line_id": "ch2_091",
      "speech_text": "今日は晴れてよかったな。"
    },
    {
      "line_id": "ch2_098",
      "speech_text": "行こう、愛理。"
    },
    {
      "line_id": "ch2_110",
      "speech_text": "ああ……懐かしいな。"
    },
    {
      "line_id": "ch2_111",
      "speech_text": "前に来たのは高校生の時……六月だったよな。"
    },
    {
      "line_id": "ch2_112",
      "speech_text": "紫陽花が一面に咲いてた。"
    },
    {
      "line_id": "ch2_114",
      "speech_text": "今はもう八月だからな——"
    },
    {
      "line_id": "ch2_115",
      "speech_text": "あ、まだ少し咲いてる。"
    },
    {
      "line_id": "ch2_121",
      "speech_text": "……来年、また一緒に来よう。"
    },
    {
      "line_id": "ch2_122",
      "speech_text": "来年の六月に。"
    },
    {
      "line_id": "ch2_138",
      "speech_text": "どうしたんだ、急にそんなこと言って……"
    },
    {
      "line_id": "ch2_142",
      "speech_text": "僕も、ずっと愛理と一緒にいたい。"
    },
    {
      "line_id": "ch2_146",
      "speech_text": "ここで最後だ……そろそろ帰ろうか？"
    },
    {
      "line_id": "ch2_151",
      "speech_text": "……そうだ！"
    },
    {
      "line_id": "ch2_152",
      "speech_text": "……ここ、すごくきれいな夕日が見えるんだ。"
    },
    {
      "line_id": "ch2_153",
      "speech_text": "昨日、調べたんだ。いちおう、デートだから……"
    },
    {
      "line_id": "ch2_154",
      "speech_text": "だから……"
    },
    {
      "line_id": "ch2_156",
      "speech_text": "まだ少し時間があるし……一緒に夕日を見ないか？"
    },
    {
      "line_id": "ch2_161",
      "speech_text": "……うん、じゃあここで少し待とう。"
    },
    {
      "line_id": "ch2_165",
      "speech_text": "じゃあ、僕は——"
    },
    {
      "line_id": "ch2_166",
      "speech_text": "飲み物を買ってくるよ。愛理は何が飲みたい？"
    },
    {
      "line_id": "ch2_buy",
      "speech_text": "分かった。じゃあ少し待ってて。"
    },
    {
      "line_id": "ch2_171",
      "speech_text": "分かった。じゃあ少し待ってて。"
    },
    {
      "line_id": "ch2_175",
      "speech_text": "いいよ、いいよ。このあと階段も上るし、疲れるだろ。"
    }
  ]
}
