{
  "chapter": "chapter2",
  "status": "draft",
  "lines": [
    { "line_id": "ch2_178", "speech_text": "うん。" },
    { "line_id": "ch2_180", "speech_text": "……海に落ちたりしないよな？" },
    { "line_id": "ch2_214", "speech_text": "すみません、一つください。" },
    { "line_id": "ch2_221", "speech_text": "……買いに行くのはやめる。" },
    { "line_id": "ch2_222", "speech_text": "このまま、君と一緒に夕日を待つよ。" },
    { "line_id": "ch2_225", "speech_text": "うん。こんなに人が多いし、僕が離れてる間に変な人に声をかけられたら困るから。" },
    { "line_id": "ch2_232", "speech_text": "今でも覚えてるんだな。" },
    { "line_id": "ch2_238", "speech_text": "ずっと一緒だ。" },
    { "line_id": "ch2_239", "speech_text": "来年も、その次の年も……また一緒に来よう。" },
    { "line_id": "ch2_249", "speech_text": "愛理……？" }
  ]
}
