{
  "chapter": "chapter1",
  "status": "draft",
  "lines": [
    {
      "line_id": "ch1_311",
      "speech_text": "あ、十屋……君……久しぶり……"
    },
    {
      "line_id": "ch1_316",
      "speech_text": "あ……そう……"
    },
    {
      "line_id": "ch1_318",
      "speech_text": "LIMEって、何？"
    },
    {
      "line_id": "ch1_320",
      "speech_text": "あ……僕、スマートフォンじゃないから……"
    },
    {
      "line_id": "ch1_322",
      "speech_text": "おい、勝手に——"
    },
    {
      "line_id": "ch1_325",
      "speech_text": "え？ 違うよ。——彼女と一緒に……"
    },
    {
      "line_id": "ch1_327",
      "speech_text": "え……？ 愛理……？"
    },
    {
      "line_id": "ch1_329",
      "speech_text": "いや……さっきまでここにいたんだ……"
    },
    {
      "line_id": "ch1_332",
      "speech_text": "……ごめん、失礼する！"
    },
    {
      "line_id": "ch1_335",
      "speech_text": "送るわけないだろ！"
    },
    {
      "line_id": "ch1_339",
      "speech_text": "愛理……"
    },
    {
      "line_id": "ch1_341",
      "speech_text": "愛理！！ よかった……どうして急にいなくなったんだ……それに携帯も急に圏外になって……ずっと探してたんだよ。"
    },
    {
      "line_id": "ch1_343",
      "speech_text": "……愛理？"
    },
    {
      "line_id": "ch1_345",
      "speech_text": "え……ど、どうして怒ってるんだ？"
    },
    {
      "line_id": "ch1_347",
      "speech_text": "！？ どうしてそんなこと言うんだ？ さっきも言っただろ、ずっと君を探してたって。"
    },
    {
      "line_id": "ch1_349",
      "speech_text": "楽しそうになんか話してない……十屋が一人でしゃべってただけだ……あいつがうるさくて気を取られて、それで君に気づかなかっただけで……"
    },
    {
      "line_id": "ch1_351",
      "speech_text": "……ごめ——"
    },
    {
      "line_id": "ch1_353",
      "speech_text": "何だよ……それ……"
    },
    {
      "line_id": "ch1_354",
      "speech_text": "言葉にして、言葉にしてって……全部言わなきゃいけないのか？ 何も言わなかったら、愛理には本当に何も分からないのか！？ どうして愛理は、そんなに言葉にすることにこだわるんだ？ 『僕の気持ちは、君を置いて一人にすること』って——何だよ、それ。ずっと、ずっと、ずっと一人だったのは、僕のほうじゃないか……！"
    },
    {
      "line_id": "ch1_355",
      "speech_text": "突然僕の前から消えて、また突然現れて、『大好き』『大好き』って……僕には分からないんだ。愛理の言う『大好き』って、いったい何なんだよ！ 愛理の『大好き』って、何なんだよ！？"
    },
    {
      "line_id": "ch1_358",
      "speech_text": "……愛理？ 愛理？ 大丈夫か……？"
    },
    {
      "line_id": "ch1_360",
      "speech_text": "……え？ 愛理——！"
    }
  ]
}
