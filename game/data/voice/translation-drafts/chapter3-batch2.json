{
  "chapter": "chapter3",
  "status": "draft",
  "lines": [
    { "line_id": "ch3_281", "speech_text": "思い出だけ残って、何になる……過去にしがみついても仕方ない。何の役にも立たない。" },
    { "line_id": "ch3_283", "speech_text": "いらないって言ってるだろ！" },
    { "line_id": "ch3_285", "speech_text": "あ……！ ご、ごめんなさい……" },
    { "line_id": "ch3_306", "speech_text": "日日谷さん……" },
    { "line_id": "ch3_309", "speech_text": "いえ、大丈夫です。日日谷さんの言うとおりです。ありがとうございます。" },
    { "line_id": "ch3_315", "speech_text": "今日は、やっぱり行くのをやめます。" },
    { "line_id": "ch3_318", "speech_text": "……携帯のデータを、先に新しいほうへ移したいんです。消えてしまう前に……大切なものですから。" },
    { "line_id": "ch3_320", "speech_text": "今日は本当にありがとうございました。ろくなお礼もできなくて、すみません。今度、僕が何か——" },
    { "line_id": "ch3_324", "speech_text": "え……電話？ ど、どうして……？" },
    { "line_id": "ch3_326", "speech_text": "はは……分かりました。" },
    { "line_id": "ch3_328", "speech_text": "はい、起きてます。" },
    { "line_id": "ch3_329", "speech_text": "……じゃあ、失礼します。皆さんによろしく伝えてください。" },
    { "line_id": "ch3_342", "speech_text": "もうこんな時間か……" },
    { "line_id": "ch3_343", "speech_text": "日日谷さんから電話が来る前に、データをこっちへ移しておこう。" },
    { "line_id": "ch3_344", "speech_text": "充電もしておかないと。" },
    { "line_id": "ch3_347", "speech_text": "ちょっとからかっただけかもしれない……" },
    { "line_id": "ch3_348", "speech_text": "そもそも、どうして僕と電話したいんだ……" },
    { "line_id": "ch3_350", "speech_text": "……ん？" },
    { "line_id": "ch3_351", "speech_text": "え？" },
    { "line_id": "ch3_352", "speech_text": "開かない……？ どうして？" },
    { "line_id": "ch3_354", "speech_text": "どうして急に……" },
    { "line_id": "ch3_355", "speech_text": "まさか、壊れたのか……！" },
    { "line_id": "ch3_356", "speech_text": "嘘……だろ……？" },
    { "line_id": "ch3_357", "speech_text": "消えた……のか……？" },
    { "line_id": "ch3_358", "speech_text": "全部……" },
    { "line_id": "ch3_360", "speech_text": "そんな……そんなことって……" },
    { "line_id": "ch3_362", "speech_text": "愛理……" },
    { "line_id": "ch3_365", "speech_text": "愛理！！" },
    { "line_id": "ch3_366", "speech_text": "あい……" },
    { "line_id": "ch3_370", "speech_text": "愛理が……泣いてる……" },
    { "line_id": "ch3_371", "speech_text": "僕を呼んでる……" },
    { "line_id": "ch3_372", "speech_text": "僕は……" },
    { "line_id": "ch3_373", "speech_text": "会いに行かないと……" },
    { "line_id": "ch3_376", "speech_text": "日日谷さん……" },
    { "line_id": "ch3_395", "speech_text": "はあ……はあ……はあ……はあ……" },
    { "line_id": "ch3_397", "speech_text": "はあ……はあ……" },
    { "line_id": "ch3_404", "speech_text": "愛理……" },
    { "line_id": "ch3_407", "speech_text": "愛理、聞いてくれ……" },
    { "line_id": "ch3_408", "speech_text": "どれだけ自分に言い聞かせても、君と一緒に暮らした日々を、ただの僕の妄想だったなんて思えない。" },
    { "line_id": "ch3_409", "speech_text": "ここで君と出会って、家で一緒に映画を見て、休みの日には水族館へ行って、江ノ島でデートもした……" },
    { "line_id": "ch3_410", "speech_text": "それが全部僕の妄想だったなんて、どうしても信じられない……" },
    { "line_id": "ch3_411", "speech_text": "僕の心の中では、君の姿があまりにも確かだったから。" },
    { "line_id": "ch3_412", "speech_text": "愛理、どうして君は十年前の姿で、僕の前に現れたんだ……" },
    { "line_id": "ch3_413", "speech_text": "いったいなぜなのか……どうやってそんなことができたのか……まだ分からないことは、たくさんあるけど……" },
    { "line_id": "ch3_414", "speech_text": "……それでも……" },
    { "line_id": "ch3_415", "speech_text": "もう一度、君に会いたいんだ。" },
    { "line_id": "ch3_416", "speech_text": "あの日、あの暗い部屋から僕を連れ出してくれた……" },
    { "line_id": "ch3_417", "speech_text": "愛理、君に。" },
    { "line_id": "ch3_418", "speech_text": "……" },
    { "line_id": "ch3_419", "speech_text": "……" }
  ]
}
